# Copy to .env and fill in. Never commit .env.

# --- Meta Model API ---
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
# false = in-memory fakes, no credits spent. Only set true when you mean it.
META_API_ENABLED=false
# Hard spend cap in USD (hackathon credits: $150 total).
META_BUDGET_LIMIT_USD=120
MUSE_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1

# --- PostgreSQL + PostGIS ---
POSTGRES_DB=civic_repairs
POSTGRES_USER=civic
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# --- Media storage (filesystem; private originals and public blurred copies in separate dirs) ---
MEDIA_STORAGE_PATH=./data/media

# --- WhatsApp Cloud API ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# --- App ---
# Local dev only (containers always use 8080).
BACKEND_PORT=8081
ADMIN_TOKEN=
PHONE_HASH_SALT=
REPORTS_PER_PHONE_PER_DAY=10
PUBLIC_BASE_URL=http://localhost:5173

# --- Production only (VPS /opt/civic-repairs/.env) ---
# Network of the shared personal-nginx proxy.
PROXY_NETWORK=deploy_personal-network
# Image tag to run; the deploy workflow passes sha-<commit>. Set an older tag here to roll back.
IMAGE_TAG=latest
