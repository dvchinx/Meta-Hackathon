# Copy to .env and fill in. Never commit .env.

# --- Meta Model API ---
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
# false = in-memory fakes, no credits spent. Only set true when you mean it.
META_API_ENABLED=false
# Hard spend cap in USD (hackathon credits: $150 total).
META_BUDGET_LIMIT_USD=120
MUSE_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1

# --- PostgreSQL + PostGIS ---
POSTGRES_DB=civic_repairs
POSTGRES_USER=civic
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# --- Media storage (filesystem; private originals and public blurred copies in separate dirs) ---
MEDIA_STORAGE_PATH=./data/media

# --- WhatsApp Cloud API ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Language the notice templates were approved in (docs/whatsapp-templates.md).
WHATSAPP_TEMPLATE_LANGUAGE=es

# --- Email (Resend; empty = links are only logged) ---
RESEND_API_KEY=
EMAIL_FROM=Daños urbanos Bogotá <civic@jesusflorez.cloud>

# --- Google sign-in (empty = button hidden) ---
GOOGLE_CLIENT_ID=

# --- App ---
# Local dev only (containers always use 8080).
BACKEND_PORT=8081
# Admin panel (#/admin): long random string, e.g. openssl rand -base64 24. Empty = no admin panel.
ADMIN_TOKEN=
PHONE_HASH_SALT=
# Encrypts the data citizens give to file petitions (ID number, names, phone). Generate: openssl rand -base64 32
# Empty = petitions disabled. Never change it in production: stored data could no longer be read.
PERSONAL_DATA_KEY=
REPORTS_PER_PHONE_PER_DAY=10
PUBLIC_BASE_URL=http://localhost:5173

# --- Demo examples (infra/seed/, local only) ---
# Base street photos for the examples. Free token at https://www.mapillary.com/developer.
MAPILLARY_TOKEN=

# --- Production only (VPS /opt/civic-repairs/.env) ---
# Network of the shared personal-nginx proxy.
PROXY_NETWORK=deploy_personal-network
# Image tag to run. The deploy workflow writes sha-<commit> here on every release (it logs the previous one).
# To roll back, set an older sha-<commit> and run `docker compose up -d`.
IMAGE_TAG=latest
